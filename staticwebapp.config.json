{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "routes": [
    { "route": "/firm-settings.json", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/*.html", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/manifest.xml", "headers": { "Cache-Control": "no-cache" } }
  ]
}
